{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.woopra.com https://www.snapchat.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com; font-src 'self' data: https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://*.woopra.com https://*.snapchat.com; media-src 'self' https://hamagardy.github.io; connect-src 'self' https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.woopra.com https://www.snapchat.com; frame-src https://www.snapchat.com; object-src 'none'; base-uri 'none'; form-action 'self' https://formspree.io; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    },
    {
      "source": "/data",
      "missing": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/data.html",
      "missing": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/xallaknm/data",
      "missing": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/xallaknm/data.html",
      "missing": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/xallaknm/data-standalone.html",
      "missing": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/tools/:path*",
      "missing": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shop.hamagardy.com"
        }
      ],
      "destination": "https://newhama.onrender.com/:path*"
    },
    {
      "source": "/data",
      "destination": "/410.html"
    },
    {
      "source": "/data.html",
      "destination": "/410.html"
    },
    {
      "source": "/xallaknm/data",
      "destination": "/410.html"
    },
    {
      "source": "/xallaknm/data.html",
      "destination": "/410.html"
    },
    {
      "source": "/xallaknm/data-standalone.html",
      "destination": "/410.html"
    },
    {
      "source": "/tools/:path*",
      "destination": "/410.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
